{
  "hosting": {
    "public": "out",
    "cleanUrls": true,
    "trailingSlash": false,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "source": "/product/skele-baby-tee",
        "destination": "/product/night-dweller-baby-tee",
        "type": 301
      }
    ],
    "rewrites": [
      {
        "source": "/api/mpesa/callback",
        "function": {
          "functionId": "mpesaCallback",
          "region": "europe-west1"
        }
      }
    ]
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules"
  }
}
