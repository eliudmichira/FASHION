{
  "hosting": {
    "public": "out",
    "cleanUrls": true,
    "trailingSlash": false,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "source": "/product/skele-baby-tee",
        "destination": "/product/night-dweller-baby-tee",
        "type": 301
      }
    ]
  }
}
