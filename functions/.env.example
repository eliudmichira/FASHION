# Copy to functions/.env and fill in. These are settings, not secrets: the
# consumer key, consumer secret, passkey and callback token go in Firebase
# secrets (see README), never in this file or the repo.

# "sandbox" to test with Safaricom's test system, "production" once Daraja has
# taken your app live.
MPESA_ENV=sandbox

# Paybill: your Paybill number. Till (Buy Goods): your store / head office number.
# 174379 is Safaricom's sandbox test Paybill.
MPESA_SHORTCODE=174379

# Who receives the money. Leave empty for a Paybill (same as the shortcode).
# For a Till, put the Till number here.
MPESA_PARTY_B=

# CustomerPayBillOnline for a Paybill, CustomerBuyGoodsOnline for a Till.
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline

# Where Safaricom sends results. Leave empty to use https://<project>.web.app.
# Set to https://classofinfinitty.shop once that domain is connected to Firebase Hosting.
MPESA_CALLBACK_BASE=
